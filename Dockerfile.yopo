FROM dzp_yopo:sim-u2004-noetic-py38

ENV PYTHONUNBUFFERED=1 \
    YOPO_ROOT=/opt/YOPO_360 \
    YOPO_CONFIG=x5_cruise15_18m_a12_mask_wc3.yaml

ENV PATH="/opt/venv/bin:$PATH"

# Copy YOPO Python code
COPY third_party/YOPO /opt/YOPO_360/YOPO

# Copy bridge script
COPY scripts/yopo_bridge.py /opt/yopo-bridge/yopo_bridge.py

WORKDIR /opt/yopo-bridge
EXPOSE 5699

CMD ["python3", "/opt/yopo-bridge/yopo_bridge.py", "--host", "0.0.0.0", "--port", "5699"]
