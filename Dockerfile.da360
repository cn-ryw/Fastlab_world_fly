ARG DA360_BASE_IMAGE=pytorch/pytorch:2.8.0-cuda12.8-cudnn9-runtime@sha256:417bd75df6365104c283ea4c1651fb3530d9eb5a4c2fafa51943cff2a94e6385
FROM ${DA360_BASE_IMAGE}

ENV PYTHONUNBUFFERED=1 \
    OPENCV_IO_ENABLE_OPENEXR=1 \
    DA360_ROOT=/opt/DA360

RUN python3 -m pip install --no-cache-dir \
      Flask==3.1.3 \
      numpy==1.26.4 \
      Pillow==12.1.1 \
      opencv-python-headless==4.11.0.86 \
      timm==1.0.28

COPY third_party/DA360 "$DA360_ROOT"
COPY scripts/da360_server.py /opt/server/da360_server.py

WORKDIR /opt/server
EXPOSE 5688
CMD ["python3", "/opt/server/da360_server.py", "--model-path", "/models/DA360_large.pth", "--host", "0.0.0.0", "--port", "5688"]
