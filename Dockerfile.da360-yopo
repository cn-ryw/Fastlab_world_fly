ARG AUTONOMY_BASE_IMAGE=pytorch/pytorch:2.8.0-cuda12.8-cudnn9-runtime@sha256:417bd75df6365104c283ea4c1651fb3530d9eb5a4c2fafa51943cff2a94e6385
FROM ${AUTONOMY_BASE_IMAGE}

ARG AUTONOMY_BASE_IMAGE
ARG MINDCLOUD_DEPENDENCY_LOCK_SHA256=unknown
ARG MINDCLOUD_IMAGE_RECIPE_SHA256=unknown
LABEL mindcloud.autonomy_base_image="${AUTONOMY_BASE_IMAGE}" \
      mindcloud.dependencies_lock_sha256="${MINDCLOUD_DEPENDENCY_LOCK_SHA256}" \
      mindcloud.image_recipe_sha256="${MINDCLOUD_IMAGE_RECIPE_SHA256}"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    OPENCV_IO_ENABLE_OPENEXR=1 \
    DA360_ROOT=/opt/DA360 \
    YOPO_ROOT=/opt/YOPO_360 \
    YOPO_CONFIG=x5_cruise15_18m_a12_mask_wc3.yaml \
    DA360_RESAMPLE=bicubic \
    DA360_CHANNELS_LAST=0 \
    YOPO_CHANNELS_LAST=0 \
    DA360_MAX_CONTENT_LENGTH=8388608

RUN python3 -m pip install --no-cache-dir \
      Flask==3.1.3 \
      numpy==1.26.4 \
      scipy==1.11.4 \
      Pillow==12.1.1 \
      opencv-python-headless==4.11.0.86 \
      ruamel.yaml==0.17.21 \
      timm==1.0.28

COPY third_party/DA360 "$DA360_ROOT"
COPY third_party/YOPO /opt/YOPO_360/YOPO
COPY scripts/da360_server.py /opt/server/da360_server.py
COPY scripts/yopo_bridge.py /opt/server/yopo_bridge.py
COPY scripts/combined_server.py /opt/server/combined_server.py

WORKDIR /opt/server
EXPOSE 5688

CMD ["python3", "/opt/server/combined_server.py", "--host", "0.0.0.0", "--port", "5688"]
