ARG CUDA_BASE_IMAGE=nvidia/cuda:12.8.0-devel-ubuntu20.04
FROM ${CUDA_BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    OPENCV_IO_ENABLE_OPENEXR=1 \
    DA360_ROOT=/opt/DA360

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        software-properties-common \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        python3.10 \
        python3.10-dev \
        python3.10-distutils \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1 \
    && rm -rf /var/lib/apt/lists/*

RUN curl -sS https://bootstrap.pypa.io/get-pip.py | python3.10 \
    && python3 -m pip install --no-cache-dir --upgrade pip

RUN python3 -m pip install --no-cache-dir \
        "numpy<2" \
        flask \
        flask-cors \
        opencv-python-headless \
        pillow \
        timm \
        tqdm \
        gdown

RUN python3 -m pip install --no-cache-dir \
        torch==2.1.1 torchvision==0.16.1 \
        --index-url https://download.pytorch.org/whl/cu121

COPY third_party/DA360 "$DA360_ROOT"

WORKDIR /opt/mindcloud-da360
COPY scripts/da360_server.py /opt/mindcloud-da360/scripts/da360_server.py

EXPOSE 5688

CMD ["python3", "/opt/mindcloud-da360/scripts/da360_server.py", "--model-path", "/models/DA360_large.pth", "--host", "0.0.0.0", "--port", "5688"]
